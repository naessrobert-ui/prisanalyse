# ---------------------------------------------------------------------------
# Kupp-vakt – miljøvariabler for Raspberry Pi
# ---------------------------------------------------------------------------
# Kopier denne fila til /etc/kupp-vakt/kupp-vakt.env og fyll inn ekte verdier.
# Installasjonsskriptet setter rettigheter til 600 (kun eier kan lese), slik at
# hemmeligheter ikke ligger lesbart for andre brukere på Pi-en.
#
# IKKE sjekk inn den utfylte fila i git – kun denne .example-fila.

# ---- AWS / S3 (må til: lookup-tabell, peer-koeffisienter og state ligger i S3) ----
AWS_ACCESS_KEY_ID=DIN_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=DIN_AWS_SECRET_KEY
AWS_REGION=eu-north-1
S3_BUCKET_NAME=prisanalyse-data

# ---- Pushover (anbefalt varslingskanal) ----
# PUSHOVER_TOKEN = API-token til appen du lagde på pushover.net/apps
# PUSHOVER_USER  = din user key (pushover.net forside). Flere mottakere:
#                  komma-separer user keys, eller bruk en delivery-group-nøkkel.
PUSHOVER_TOKEN=DITT_PUSHOVER_APP_TOKEN
PUSHOVER_USER=DIN_PUSHOVER_USER_KEY

# ---- E-post (valgfritt – kan brukes i stedet for eller i tillegg til Pushover) ----
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=din@gmail.com
#SMTP_PASSWORD=app-passord
#KUPP_VARSEL_TO=mottaker1@epost.no,mottaker2@epost.no
#KUPP_VARSEL_FROM=din@gmail.com

# ---- Terskel: trappetrinn etter pris (dyrere bil = lavere prosentkrav) ----
# < 50k -> 30 %, < 100k -> 20 %, < 150k -> 15 %, < 250k -> 7 %, ellers -> 6 %.
# Format: "maxpris:minprosent,...". Tom siste maxpris = uendelig.
export KUPP_RABATT_TRAPP="50000:30,100000:20,150000:15,250000:7,:6"
# Valgfri flat kroneterskel i tillegg (0 = av). "Under hurtigpris" som ekstra
# signal (0 = av). La begge stå av når trappa styrer.
export KUPP_RABATT_KR_MIN=0
export KUPP_UNDER_HURTIG=0

# ---- Filtre (valgfritt – tom = alt) ----
# Selger: kupp finnes hos private (forhandlere priser til marked med margin).
# "privat" (default), "merkeforhandler", "annet" eller "alle".
export KUPP_SELGER="privat"
# Drivstoff: f.eks. "Elektrisk" eller "Elektrisk,Hybrid".
#export KUPP_DRIVSTOFF="Elektrisk"
# Fylke: navn ("Vestland,Rogaland") ELLER rå FINN-kode ("0.22046").
# Gyldige navn: Østfold, Akershus, Oslo, Innlandet, Buskerud, Vestfold,
# Telemark, Agder, Rogaland, Vestland, Møre og Romsdal, Trøndelag, Nordland,
# Troms, Finnmark. Server-side filter – henter kun biler i valgt(e) fylke(r).
#export KUPP_FYLKE="Vestland"
# Sted: delstreng på poststed/område ("Bergen,Voss"). Finere enn fylke.
#export KUPP_STED="Bergen"

# ---- Hjemfylke-vekting: strengere krav utenfor eget fylke ----
# I stedet for å låse søket til ett fylke (KUPP_FYLKE) kan du hente hele landet,
# men kreve STØRRE rabatt for biler utenfor hjemfylket (de koster frakt/henting).
# La KUPP_FYLKE stå TOM for at dette skal gjelde – ellers henter du bare ett fylke.
# Biler i hjemfylket beholder den vanlige trappa; utenfor legges tillegget på.
export KUPP_HJEMFYLKE="Vestland"
export KUPP_UTENFOR_TILLEGG_PP=10     # +10 pp rabattkrav for resten av landet (0 = av)
# Nabofylker med kortere reise får et mindre tillegg enn resten:
export KUPP_NABOFYLKE="Rogaland,Møre og Romsdal"
export KUPP_NABO_TILLEGG_PP=5         # +5 pp rabattkrav i nabofylkene

# ---- Elbil: merke-tiered rabattkrav (fra kupp_backtest --per produsent) ----
# Slår på merke-spesifikk terskel for elbiler (erstatter pris-trappa for EV).
# Sterke merker (selger raskt ved lav rabatt) får lav terskel; premium/nisje høy.
export KUPP_EL_TIER=1
export KUPP_EL_MERKER_LAV="Tesla,Kia,Nissan,Renault,Volkswagen,MG,Hyundai,Peugeot"
export KUPP_EL_MERKER_MEDIUM="BMW,Audi,Polestar,Ford"
export KUPP_EL_MERKER_HOY="Volvo,Toyota,Skoda,Mercedes-Benz,Porsche,BYD"
export KUPP_EL_TERSKEL_LAV=2          # % rabattkrav for sterke merker
export KUPP_EL_TERSKEL_MEDIUM=6
export KUPP_EL_TERSKEL_HOY=12
export KUPP_EL_TERSKEL_DEFAULT=12     # ukjent/nisje elbil-merke -> forsiktig (høy)

# ---- Kurante modeller: slipp litt flere gjennom ----
# Lette-å-omsette-modeller kan få lavere rabattkrav. Komma-separert liste med
# "Merke Modell"-fragment (delstreng, case-uavhengig).
export KUPP_KURANTE="Volkswagen Golf"
export KUPP_KURANT_LETTELSE_PP=3      # -3 prosentpoeng rabattkrav for kurante

# Maks antall biler i ett varsel, og hvor mange FINN-sider som skrapes per søk.
#export KUPP_MAX_VARSLER=40
#export KUPP_MAX_PAGES=2

# ---- Kupp-logg / etteranalyse (valgfritt) ----
# Hver varslede bil logges til S3 med egenskapene sine, slik at
# `python -m scripts.kupp_analyse` kan vise hva som kjennetegner biler som
# faktisk blir solgt (til å tune tersklene over). Loggen prunes etter TTL.
#export KUPP_VAKT_LOGG_KEY="calc/bil/kupp_vakt_logg.json"
#export KUPP_VAKT_LOGG_TTL_DAYS=120
# Overstyr solgt-markørene analysen ser etter i FINN-annonsen (adskilt med |),
# hvis FINN endrer markup. Kjør `kupp_analyse --verbose` for å sjekke treff.
#export KUPP_SOLGT_MARKORER='"disposed":true|>solgt<|content="oos"'
