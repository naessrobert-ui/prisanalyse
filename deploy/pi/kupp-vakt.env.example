# ---------------------------------------------------------------------------
# Kupp-vakt – miljøvariabler for Raspberry Pi
# ---------------------------------------------------------------------------
# Kopier denne fila til /etc/kupp-vakt/kupp-vakt.env og fyll inn ekte verdier.
# Installasjonsskriptet setter rettigheter til 600 (kun eier kan lese), slik at
# hemmeligheter ikke ligger lesbart for andre brukere på Pi-en.
#
# IKKE sjekk inn den utfylte fila i git – kun denne .example-fila.

# ---- AWS / S3 (må til: lookup-tabell, peer-koeffisienter og state ligger i S3) ----
AWS_ACCESS_KEY_ID=DIN_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=DIN_AWS_SECRET_KEY
AWS_REGION=eu-north-1
S3_BUCKET_NAME=prisanalyse-data

# ---- Pushover (anbefalt varslingskanal) ----
# PUSHOVER_TOKEN = API-token til appen du lagde på pushover.net/apps
# PUSHOVER_USER  = din user key (pushover.net forside). Flere mottakere:
#                  komma-separer user keys, eller bruk en delivery-group-nøkkel.
PUSHOVER_TOKEN=DITT_PUSHOVER_APP_TOKEN
PUSHOVER_USER=DIN_PUSHOVER_USER_KEY

# ---- E-post (valgfritt – kan brukes i stedet for eller i tillegg til Pushover) ----
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=din@gmail.com
#SMTP_PASSWORD=app-passord
#KUPP_VARSEL_TO=mottaker1@epost.no,mottaker2@epost.no
#KUPP_VARSEL_FROM=din@gmail.com

# ---- Terskler (valgfritt – dette er standardverdiene) ----
# Varsle hvis ETT av kriteriene slår til:
#   rabatt i prosent >= KUPP_RABATT_MIN, ELLER
#   rabatt i kroner  >= KUPP_RABATT_KR_MIN (fanger dyre biler), ELLER
#   pris < hurtigpris (hvis KUPP_UNDER_HURTIG=1)
KUPP_RABATT_MIN=15
KUPP_RABATT_KR_MIN=50000
KUPP_UNDER_HURTIG=1

# Maks antall biler i ett varsel, og hvor mange FINN-sider som skrapes per søk.
#KUPP_MAX_VARSLER=40
#KUPP_MAX_PAGES=2
