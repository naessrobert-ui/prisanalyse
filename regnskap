#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import re
import csv
import time
import json
import urllib3
import requests
import pandas as pd

from bs4 import BeautifulSoup
from datetime import datetime
from urllib.parse import urlparse, parse_qs, unquote
from urllib3.util.retry import Retry
from requests.adapters import HTTPAdapter

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# -----------------------------
# Konfig
# -----------------------------
USER_AGENT = "Mozilla/5.0"
TIMEOUT = 15
SLEEP_BETWEEN_REQUESTS_SEC = 0.6  # vær snill mot tjenesten
DEFAULT_LAST_N_YEARS = 3

# Fallbacks hvis Excel kun har orgnr (vi prøver flere varianter)
URL_TEMPLATES = [
    "https://www.proff.no/regnskap/-/{org}",
    "https://www.proff.no/regnskap/{org}",
]

# -----------------------------
# Felles: session/proxy
# -----------------------------
def make_session(use_proxy: bool, user_ac: str = "", pwd: str = "") -> requests.Session:
    sess = requests.Session()
    retries = Retry(
        total=6,
        backoff_factor=1,
        status_forcelist=[429, 500, 502, 503, 504],
        allowed_methods=["GET"],
    )
    sess.mount("https://", HTTPAdapter(max_retries=retries))
    sess.headers.update({"User-Agent": USER_AGENT})

    if use_proxy:
        proxies = {
            "http":  f"http://{user_ac}:{pwd}@dk.client-swg.oneadr.net:8080",
            "https": f"http://{user_ac}:{pwd}@dk.client-swg.oneadr.net:8080",
        }
        sess.proxies.update(proxies)

    return sess


def ask_proxy_credentials() -> tuple[bool, str, str]:
    use_proxy_in = input("Bruk proxy (AC-bruker)? [j/N]: ").strip().lower()
    use_proxy = use_proxy_in in ("j", "ja", "y", "yes")
    if not use_proxy:
        return False, "", ""

    user_raw = input("Oppgi bruker-ID (tallene etter AC): ").strip()
    user_ac = "AC" + user_raw
    pwd = input("Oppgi passord: ").strip()
    return True, user_ac, pwd


# -----------------------------
# Felles: Proff __NEXT_DATA__ parsing
# -----------------------------
def try_fetch_payload(sess: requests.Session, url: str) -> dict | None:
    r = sess.get(url, verify=False, timeout=TIMEOUT)
    if r.status_code != 200:
        return None

    soup = BeautifulSoup(r.text, "html.parser")
    script = soup.find("script", {"id": "__NEXT_DATA__", "type": "application/json"})
    if not script or not script.string:
        return None

    try:
        return json.loads(script.string)
    except Exception:
        return None


def get_company_name(payload: dict) -> str:
    company = payload.get("props", {}).get("pageProps", {}).get("company", {})
    for key in ("name", "companyName", "displayName"):
        v = company.get(key)
        if isinstance(v, str) and v.strip():
            return v.strip()
    return ""


def extract_accounts_df(payload: dict) -> tuple[pd.DataFrame, str]:
    company = payload["props"]["pageProps"].get("company", {})
    currency = company.get("currency", "NOK")

    accounts = company.get("companyAccounts", []) or []
    records = []
    for y in accounts:
        rec = {"year": y.get("year")}
        for a in y.get("accounts", []):
            code = a.get("code")
            amt = a.get("amount")
            if isinstance(amt, str):
                amt = amt.replace(" ", "").replace("\xa0", "")
            try:
                amt = float(amt)
            except Exception:
                pass
            if code:
                rec[code] = amt
        if rec.get("year") is not None:
            records.append(rec)

    if not records:
        return pd.DataFrame(), currency

    df_sum = pd.DataFrame(records).set_index("year").sort_index()
    return df_sum, currency


def compute_rfs(df_sum: pd.DataFrame) -> pd.Series:
    # Resultat før skatt: DR + FI - FK hvis alle finnes.
    if all(c in df_sum.columns for c in ("DR", "FI", "FK")):
        return df_sum["DR"] + df_sum["FI"] - df_sum["FK"]
    return pd.Series(index=df_sum.index, dtype="float64")


def normalize_orgnr(v) -> str:
    s = str(v).strip()
    s = re.sub(r"\D", "", s)
    return s


def build_urls(org: str, url_from_sheet: str | None) -> list[str]:
    urls: list[str] = []
    if url_from_sheet and isinstance(url_from_sheet, str) and url_from_sheet.strip():
        urls.append(url_from_sheet.strip())
    for tpl in URL_TEMPLATES:
        urls.append(tpl.format(org=org))

    seen = set()
    out = []
    for u in urls:
        if u not in seen:
            seen.add(u)
            out.append(u)
    return out


# -----------------------------
# (1) Batch fra Excel (som Proff_all)
# -----------------------------
def run_batch_from_excel(sess: requests.Session):
    print("\n--- Batch regnskap fra Excel (siste N år) ---\n")

    in_path = input("Oppgi sti til Excel med orgnr (f.eks. orgnr.xlsx): ").strip()
    if not os.path.exists(in_path):
        raise FileNotFoundError(f"Fant ikke fil: {in_path}")

    print("\nTips: Excel bør ha kolonne 'OrgNr'. Valgfritt: 'ProffURL'.")
    org_col = input("Navn på orgnr-kolonne [OrgNr]: ").strip() or "OrgNr"
    url_col = input("Navn på URL-kolonne (tom = ingen) [ProffURL]: ").strip() or "ProffURL"

    n_years_in = input(f"Hent siste hvor mange år? [{DEFAULT_LAST_N_YEARS}]: ").strip()
    last_n_years = int(n_years_in) if n_years_in else DEFAULT_LAST_N_YEARS

    df_in = pd.read_excel(in_path)
    if org_col not in df_in.columns:
        raise ValueError(f"Mangler kolonnen '{org_col}' i Excel.")

    have_url = url_col in df_in.columns

    today = datetime.today().strftime("%Y-%m-%d")
    out_path = os.path.join(os.path.dirname(in_path), f"proff_batch_{today}.xlsx")

    rows = []
    errors = []

    orgs = df_in[org_col].dropna().tolist()
    print(f"\nFant {len(orgs)} organisasjonsnumre.\n")

    for i, org_raw in enumerate(orgs, start=1):
        org = normalize_orgnr(org_raw)
        url_in_sheet = None
        if have_url:
            # behold din originale logikk – men tryggere:
            sel = df_in[org_col] == org_raw
            if sel.any():
                url_in_sheet = df_in.loc[sel, url_col].iloc[0]

        print(f"[{i}/{len(orgs)}] Henter orgnr {org} ...")

        payload = None
        used_url = None
        urls_tried = build_urls(org, url_in_sheet)

        for url in urls_tried:
            try:
                payload_try = try_fetch_payload(sess, url)
                if payload_try:
                    payload = payload_try
                    used_url = url
                    break
            except Exception:
                continue

        if not payload:
            errors.append({
                "orgnr": org,
                "error": "Fant ikke __NEXT_DATA__ payload / ingen fungerende URL",
                "url_tried": "; ".join(urls_tried),
            })
            print("  -> FEIL: klarte ikke hente payload")
            time.sleep(SLEEP_BETWEEN_REQUESTS_SEC)
            continue

        try:
            df_sum, currency = extract_accounts_df(payload)
            if df_sum.empty:
                errors.append({"orgnr": org, "error": "Ingen companyAccounts i payload", "url_used": used_url})
                print("  -> FEIL: ingen regnskap i payload")
                time.sleep(SLEEP_BETWEEN_REQUESTS_SEC)
                continue

            df_last = df_sum.sort_index(ascending=False).head(last_n_years).sort_index()
            rfs = compute_rfs(df_last)
            company_name = get_company_name(payload)

            for year in df_last.index.tolist():
                ar = df_last["AR"].get(year) if "AR" in df_last.columns else None
                sek = df_last["SEK"].get(year) if "SEK" in df_last.columns else None
                rfs_y = rfs.get(year) if not rfs.empty else None

                rows.append({
                    "orgnr": org,
                    "company": company_name,
                    "currency": currency,
                    "year": int(year),
                    "resultat_for_skatt": rfs_y,
                    "resultat_etter_skatt": ar,
                    "egenkapital": sek,
                    "url_used": used_url,
                })

            print("  -> OK")
        except Exception as e:
            errors.append({"orgnr": org, "error": f"Parse/transform-feil: {e}", "url_used": used_url})
            print(f"  -> FEIL: {e}")

        time.sleep(SLEEP_BETWEEN_REQUESTS_SEC)

    df_long = pd.DataFrame(rows)

    df_wide = pd.DataFrame()
    if not df_long.empty:
        piv_rfs = df_long.pivot_table(
            index=["orgnr", "company", "currency"],
            columns="year",
            values="resultat_for_skatt",
            aggfunc="first",
        )
        piv_ar = df_long.pivot_table(
            index=["orgnr", "company", "currency"],
            columns="year",
            values="resultat_etter_skatt",
            aggfunc="first",
        )
        piv_sek = df_long.pivot_table(
            index=["orgnr", "company", "currency"],
            columns="year",
            values="egenkapital",
            aggfunc="first",
        )

        piv_rfs.columns = [f"resultat_for_skatt_{c}" for c in piv_rfs.columns]
        piv_ar.columns  = [f"resultat_etter_skatt_{c}" for c in piv_ar.columns]
        piv_sek.columns = [f"egenkapital_{c}" for c in piv_sek.columns]

        df_wide = pd.concat([piv_rfs, piv_ar, piv_sek], axis=1).reset_index()

    df_err = pd.DataFrame(errors)

    with pd.ExcelWriter(out_path, engine="openpyxl") as writer:
        df_long.to_excel(writer, sheet_name="DATA_LONG", index=False)
        df_wide.to_excel(writer, sheet_name="DATA_WIDE", index=False)
        df_err.to_excel(writer, sheet_name="ERRORS", index=False)

    print("\nFerdig!")
    print("Skrev:", out_path)
    print(f"OK rader: {len(df_long)} | Feil: {len(df_err)}")
    if len(df_err) > 0:
        print("Sjekk arket 'ERRORS' for detaljer.")


# -----------------------------
# (2) Søk/treffliste (som Proff.py)
# -----------------------------
def run_search_export(sess: requests.Session):
    print("\n--- Proff søk/treffliste → CSV ---\n")
    base_url = input("Oppgi url (hele kommandolinjen i proff): ").strip()

    parsed_url = urlparse(base_url)
    query_params = parse_qs(parsed_url.query)
    q_value = unquote(query_params.get("q", [""])[0]).strip() or "query"

    today = datetime.today().strftime("%d-%m-%Y")
    default_out = f"Proff_{q_value}_{today}.csv"

    out_dir = input("Output-mappe (tom = current directory): ").strip() or os.getcwd()
    os.makedirs(out_dir, exist_ok=True)

    out_path = os.path.join(out_dir, default_out)
    print("Skriver til:", out_path)

    # Proff paging
    page_tpl = base_url + "&page={}"

    with open(out_path, mode="w", newline="", encoding="utf-16") as file:
        writer = csv.writer(file, delimiter=";")
        writer.writerow(["firma", "org_nr", "telefon", "adresse", "år", "inntekter", "ansatte", "leder", "bransjer"])

        page_nr = 1
        fortsett = True

        while fortsett:
            print(f"Henter data fra side {page_nr}...")
            url = page_tpl.format(page_nr)

            # robust retry-loop (samme idé som din)
            page = None
            for forsok in range(1, 11):
                try:
                    page = sess.get(url, timeout=TIMEOUT, verify=False)
                    page.raise_for_status()
                    break
                except Exception:
                    wait_time = 2 ** forsok
                    print(f"Feil ved henting av {url} (Forsøk {forsok}). Venter {wait_time} sekunder ...")
                    time.sleep(wait_time)

            if page is None:
                print("Stopper: klarte ikke hente siden.")
                break

            soup = BeautifulSoup(page.text, "html.parser")
            results = soup.find_all("div", class_="SearchResultCard-card")

            if not results:
                fortsett = False
                break

            for result in results:
                firma = org_nr = adresse = inntekter = ansatte = leder = telefon = år = " "
                firma_tag = result.find("a", class_="addax-cs_hl_hit_company_name_click")
                if firma_tag:
                    firma = firma_tag.text.strip()

                org_span = next((s for s in result.find_all("span") if s.string and "Org nr" in s.string), None)
                if org_span:
                    org_nr = "".join(re.findall(r"\d+", org_span.parent.text.strip()))

                tel_span = next((s for s in result.find_all("span") if s.string and "Telefon" in s.string), None)
                if tel_span:
                    telefon = "".join(re.findall(r"\d+", tel_span.parent.text.strip()))

                adresse_span = None
                for span in result.find_all("span"):
                    if span.find("svg", {"data-icon": "location-dot"}):
                        adresse_span = span
                adresse = adresse_span.text.strip() if adresse_span else "Ikke funnet"

                # Driftsinntekter + år
                for div in result.find_all("div", class_="CardHeader-propertyBlock"):
                    header = div.find("div", class_="CardHeader-propertyHeader")
                    if header:
                        match_år = re.search(r"Driftsinntekter\s*(\d{4})", header.text)
                        if match_år:
                            år = match_år.group(1)
                            full_text = div.get_text(strip=True)
                            inntekter_raw = full_text.replace(header.text, "").strip()
                            inntekter = "".join(re.findall(r"[\d]", inntekter_raw))

                # Ansatte (snitt hvis intervall)
                for div in result.find_all("div", class_="CardHeader-propertyBlock"):
                    header = div.find("div", class_="CardHeader-propertyHeader")
                    if header and "Ansatte" in header.text:
                        full_text = div.get_text(strip=True)
                        renset = re.sub(r"[^0-9\-]", "", full_text).strip()
                        if "-" in renset:
                            deler = renset.split("-")
                            if len(deler) > 1 and deler[0].isdigit() and deler[1].isdigit():
                                tall1 = int(deler[0])
                                tall2 = int(deler[1])
                                ansatte = int((tall1 + tall2) / 2)
                        else:
                            ansatte = renset

                leder_div = next((div for div in result.find_all("div") if div.string == "Daglig leder"), None)
                if leder_div:
                    leder_a = leder_div.find_next_sibling("a")
                    if leder_a:
                        leder = leder_a.text.strip()

                bransjer = [tag.text.strip() for tag in result.select(".IndustryTags-tags a")]

                writer.writerow([firma, org_nr, telefon, adresse, år, inntekter, ansatte, leder, ", ".join(bransjer)])

            page_nr += 1
            time.sleep(SLEEP_BETWEEN_REQUESTS_SEC)

    print("Ferdig! Fil lagret som:", out_path)


# -----------------------------
# (3) Enkelt selskap detaljert (som Proff_enkelt.py)
# -----------------------------
def run_single_company_detailed(sess: requests.Session):
    print("\n--- Ett selskap (URL) → RESULTATREGNSKAP & BALANSEREGNSKAP ---\n")
    url = input("Lim inn hele Proff-URL-en (regnskap-siden): ").strip()

    m = re.search(r"/regnskap/([^/?#]+)", url)
    name = unquote(m.group(1)) if m else "selskap"

    today = datetime.today().strftime("%d-%m-%Y")
    out_file = f"Proff_{name}_{today}.xlsx"

    out_dir = input("Output-mappe (tom = current directory): ").strip() or os.getcwd()
    os.makedirs(out_dir, exist_ok=True)

    out_path = os.path.join(out_dir, out_file)
    print("Skriver til:", out_path)

    payload = try_fetch_payload(sess, url)
    if not payload:
        raise RuntimeError("Fant ikke __NEXT_DATA__ payload på URL-en. Sjekk at URL er riktig og at du har tilgang.")

    df_sum, _currency = extract_accounts_df(payload)
    if df_sum.empty:
        raise RuntimeError("Ingen companyAccounts i payload.")

    # Legg til RFS hvis mulig
    if all(c in df_sum.columns for c in ("DR", "FI", "FK")):
        df_sum["RFS"] = df_sum["DR"] + df_sum["FI"] - df_sum["FK"]

    mapping_res = [
        ("Sum salgsinntekter", "SI"),
        ("Annen driftsinntekt", "ADI"),
        ("Sum driftsinntekter", "SDI"),
        ("Varekostnad", "VF"),
        ("Beholdningsendringer", "BE"),
        ("Lønnskostnader", "LTP"),
        ("Herav kun lønn", "KLON"),
        ("Andre driftskostnader", "ADK"),
        ("Driftsresultat (EBIT)", "DR"),
        ("Sum annen renteinntekt", "ARI"),
        ("Sum annen finansinntekt", "AFI"),
        ("Sum finansinntekter", "FI"),
        ("Sum annen rentekostnad", "FK"),
        ("Sum finanskostnader", "AFK"),
        ("Resultat før skatt", "RFS"),
        ("Sum skatt", "BS"),
        ("Ordinært resultat", "OR"),
        ("Årsresultat", "AR"),
    ]
    rows = [(label, df_sum[code]) for (label, code) in mapping_res if code in df_sum.columns]
    df_res = pd.DataFrame(dict(rows))

    mapping_bal = [
        ("Goodwill", "IPI"),
        ("Sum immaterielle midler", "IMI"),
        ("Sum anleggsmidler", "SAI"),
        ("Sum varige driftsmidler", "SVD"),
        ("Sum finansielle anleggsmidler", "AFI"),
        ("Sum varelager", "SVA"),
        ("Kundefordringer", "KUF"),
        ("Andre fordringer", "ANF"),
        ("Sum fordringer", "SF"),
        ("Kasse/Bank/Post", "KBP"),
        ("Sum omløpsmidler", "SOM"),
        ("Sum eiendeler", "SED"),
        ("Sum egenkapital", "SEK"),
        ("Sum gjeld", "SG"),
        ("Sum egenkapital og gjeld", "SGE"),
    ]
    rows = [(label, df_sum[code]) for (label, code) in mapping_bal if code in df_sum.columns]
    df_bal = pd.DataFrame(dict(rows))

    currency = payload["props"]["pageProps"]["company"].get("currency", "NOK")
    for df in (df_res, df_bal):
        cols = list(df.columns)
        cur = pd.Series({c: currency for c in cols}, name="Valuta")
        df.insert(0, "Valuta", cur)

    with pd.ExcelWriter(out_path, engine="openpyxl") as writer:
        df_res.to_excel(writer, sheet_name="RESULTATREGNSKAP")
        df_bal.to_excel(writer, sheet_name="BALANSEREGNSKAP")

    print("Ferdig! Fil lagret som:", out_path)


# -----------------------------
# Meny / main
# -----------------------------
def main():
    print("\n=== Proff Toolbox ===")
    use_proxy, user_ac, pwd = ask_proxy_credentials()
    sess = make_session(use_proxy=use_proxy, user_ac=user_ac, pwd=pwd)

    while True:
        print("\nVelg funksjon:")
        print("  1) Batch regnskap fra Excel (orgnr-liste)")
        print("  2) Eksporter søk/treffliste fra Proff-URL til CSV")
        print("  3) Detaljert regnskap for ett selskap (Proff-URL) til Excel")
        print("  0) Avslutt")

        choice = input("Valg: ").strip()

        try:
            if choice == "1":
                run_batch_from_excel(sess)
            elif choice == "2":
                run_search_export(sess)
            elif choice == "3":
                run_single_company_detailed(sess)
            elif choice == "0":
                print("Ha det!")
                break
            else:
                print("Ugyldig valg.")
        except Exception as e:
            print("\n*** FEIL ***")
            print(e)


if __name__ == "__main__":
    main()
